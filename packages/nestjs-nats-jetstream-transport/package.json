{
  "name": "@kodeblox/nestjs-nats-jetstream-transport",
  "version": "2.2.8",
  "description": "Nats JetStream Transport for NestJS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kodeblox/nestjs-plugins",
    "directory": "packages/nestjs-nats-jetstream-transport"
  },
  "keywords": [
    "nestjs",
    "transport",
    "microservices",
    "nats",
    "streaming",
    "jetstream",
    "pubsub",
    "event",
    "messaging"
  ],
  "scripts": {
    "test": "jest && jest --config ./test/jest-integration.json --runInBand",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "watch": "tsc -w -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:unit": "jest",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "check:no-static-nats": "node scripts/check-no-static-nats.js dist"
  },
  "author": "Bernt Anker [bernt.anker@gmail.com]",
  "license": "ISC",
  "dependencies": {
    "nats": "^2.28.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.4.0"
  },
  "devDependencies": {
    "@nestjs/common": "^8.2.0",
    "@nestjs/core": "^8.2.0",
    "@nestjs/microservices": "^8.2.0",
    "@types/jest": "^27.0.2",
    "@typescript-eslint/eslint-plugin": "^5.33.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^27.5.1",
    "prettier": "^2.7.1",
    "rimraf": "^3.0.2",
    "ts-jest": "^27.1.5",
    "typescript": "^4.4.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
