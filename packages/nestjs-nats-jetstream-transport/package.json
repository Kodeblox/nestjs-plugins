{
  "name": "@kodeblox/nestjs-nats-jetstream-transport",
  "version": "3.0.1",
  "description": "Nats JetStream Transport for NestJS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kodeblox/nestjs-plugins",
    "directory": "packages/nestjs-nats-jetstream-transport"
  },
  "keywords": [
    "nestjs",
    "transport",
    "microservices",
    "nats",
    "streaming",
    "jetstream",
    "pubsub",
    "event",
    "messaging"
  ],
  "scripts": {
    "test": "jest && jest --config ./test/jest-integration.json --runInBand",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "watch": "tsc -w -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:unit": "jest",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:integration:legacy": "jest --config ./test/jest-integration.json --runInBand test/integration/nats-jetstream.integration.spec.ts",
    "test:integration:modern": "jest --config ./test/jest-integration.json --runInBand test/integration/nats-jetstream-modern.integration.spec.ts",
    "test:integration:ci": "node scripts/run-integration-ci.js",
    "check:no-static-nats": "node scripts/check-no-static-nats.js dist",
    "check:decoupled-dts": "npm run build && node scripts/check-decoupled-dts.js",
    "check:tarball:no-nats": "node scripts/check-tarball-no-nats.js"
  },
  "author": "Bernt Anker [bernt.anker@gmail.com]",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@nats-io/jetstream": "^3.0.0",
    "@nats-io/nats-core": "^3.0.0",
    "@nats-io/transport-node": "^3.0.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@nestjs/microservices": "^11.0.0 || ^12.0.0",
    "nats": "^2.28.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.4.0"
  },
  "peerDependenciesMeta": {
    "nats": {
      "optional": true
    },
    "@nats-io/transport-node": {
      "optional": true
    },
    "@nats-io/jetstream": {
      "optional": true
    },
    "@nats-io/nats-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nats-io/jetstream": "^3.5.0",
    "@nats-io/nats-core": "^3.5.0",
    "@nats-io/transport-node": "^3.5.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^5.33.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^30.0.0",
    "nats": "^2.28.2",
    "prettier": "^2.7.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.4.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^@nats-io/nats-core/internal$": "<rootDir>/../../../node_modules/@nats-io/nats-core/lib/internal_mod.js"
    }
  }
}
